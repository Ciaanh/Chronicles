<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

    <Script file="EventListTemplate.lua"/>

    <Button name="EventListItemTemplate" mixin="EventListItemMixin" virtual="true">
        <Size x="150" y="110"/>
        <KeyValues>
            <KeyValue key="textureHeight" value="80" type="number"/>
        </KeyValues>
        <Layers>
            <Layer level="BACKGROUND">

                <!-- Fixed 45x64 art, pinned to the left edge -->
                <Texture parentKey="Side" file="Interface\AddOns\Chronicles\Art\Bookmark-side">
                    <Size x="45" y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>

                <!--
                    Spans from the side art to the row's right edge rather than carrying a fixed 105
                    width: a linear scroll view stretches each row to the scroll box width, so a
                    fixed-width strip anchored RIGHT would leave a gap in the middle of the row.
                -->
                <Texture parentKey="Content" file="Interface\AddOns\Chronicles\Art\Bookmark-content">
                    <Size y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Side" relativePoint="RIGHT" x="0" y="0"/>
                        <Anchor point="RIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>

            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="ChroniclesFontFamily_Text_Shadow_Small" justifyH="CENTER" wordWrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Content" x="10" y="-12" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Content" x="-10" y="18" />
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR" />
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>

    <Frame name="EventListTemplate" mixin="EventListMixin" virtual="true">
        <Frames>
            <!--
                Scrolling, single-column event rail on the modern ScrollBox: a WowScrollBoxList plus
                a MinimalScrollBar, wired with a linear view in EventListMixin. Rows come from the
                shared EventListItemTemplate via templateKeys.EVENT_DESCRIPTION. The scroll region is
                inset top and bottom by the book's own 50 page padding so the first row lines up with
                the book page beside it.
            -->
            <Frame parentKey="EventScrollList" inherits="WowScrollBoxList">
                <Anchors>
                    <!-- Left inset clears the scroll bar; the right edge runs to the rail edge, which
                         sits under the book, so the bookmark tips tuck in. Top/bottom inset by the
                         book's own 50 page padding so row 1 lines up with the book page. -->
                    <Anchor point="TOPLEFT" x="16" y="-50"/>
                    <Anchor point="BOTTOMRIGHT" x="0" y="50"/>
                </Anchors>
            </Frame>
            <!-- Scroll bar on the outer (left) edge so nothing separates the bookmarks from the book -->
            <EventFrame parentKey="EventScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.EventScrollList" relativePoint="TOPLEFT" x="-4" y="-3"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.EventScrollList" relativePoint="BOTTOMLEFT" x="-4" y="2"/>
                </Anchors>
            </EventFrame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

</Ui>