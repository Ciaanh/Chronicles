<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

    <Script file="EventListTemplate.lua"/>

    <!--
        There is no event row template here any more. Events, Characters and Factions all render
        VerticalListItemTemplate (UI/VerticalListTemplate.xml): the two row templates drew the same
        bookmark art at two different heights, and only the shared one carried hover and selection.
        templateKeys.EVENT_DESCRIPTION now resolves to it in PageTemplatesRegistration.lua, so the
        list mixins stay separate (period-driven here, search-driven there) while the row is one thing.
    -->

    <!--
        One bar of the period breakdown above the rail: how many of the period's events start in this
        slice of it. At 10-year zoom a slice is one year. Clicking a bar narrows the rail to that slice;
        clicking it again clears the narrowing.
    -->
    <Button name="EventListYearBarTemplate" mixin="EventListYearBarMixin" virtual="true">
        <Size x="26" y="42"/>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- Baseline, so an empty slice still reads as a slot rather than a gap -->
                <Texture parentKey="Baseline">
                    <Size y="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="1" y="14"/>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="14"/>
                    </Anchors>
                    <Color r="0.35" g="0.3" b="0.22" a="1"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <!-- Height set per slice in EventListYearBarMixin:Init, 28 at the busiest slice -->
                <Texture parentKey="Bar">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="1" y="14"/>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="14"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Label" inherits="ChroniclesFontFamily_Text_Shadow_Small" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="BOTTOM" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" setAllPoints="true" alphaMode="ADD">
                    <Color r="1" g="0.82" b="0" a="0.12"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick method="OnClick"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!--
        An event-type chip under the bars: "Battle 4". Same label-plate art as the filter strip's chips
        on the Characters and Factions tabs; the width follows the text, set in Init.
    -->
    <Button name="EventListTypeChipTemplate" mixin="EventListTypeChipMixin" virtual="true">
        <Size x="60" y="22"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" file="Interface\AddOns\Chronicles\Art\label" setAllPoints="true"/>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="SelectedGlow" file="Interface\AddOns\Chronicles\Art\label"
                         alphaMode="ADD" alpha="0.45" setAllPoints="true" hidden="true"/>
            </Layer>
        </Layers>
        <ButtonText parentKey="Text" justifyH="CENTER">
            <Anchors>
                <Anchor point="TOPLEFT" x="4" y="-2"/>
                <Anchor point="BOTTOMRIGHT" x="-4" y="2"/>
            </Anchors>
        </ButtonText>
        <NormalFont style="ChroniclesFontFamily_Text_Shadow_Small"/>
        <Scripts>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>

    <Frame name="EventListTemplate" mixin="EventListMixin" virtual="true">
        <Frames>
            <!--
                Search box, mirroring the one on the Characters and Factions rail so all three rails
                offer the same affordance. It filters *within the selected period*, which is the Events
                rail's contract: the period is what puts rows here in the first place.
            -->
            <EditBox parentKey="SearchBox" inherits="InputBoxTemplate" autoFocus="false">
                <Size y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="0"/>
                    <Anchor point="TOPRIGHT" x="-12" y="0"/>
                </Anchors>
                <FontString inherits="ChroniclesFontFamily_Text_Medium"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="PlaceholderText" inherits="ChroniclesFontFamily_Text_Medium" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT" x="5" y="0"/>
                            </Anchors>
                            <Color r="0.5" g="0.5" b="0.5" a="0.8"/>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnTextChanged>
                        if self:GetText() ~= "" then
                            self.PlaceholderText:Hide()
                        else
                            self.PlaceholderText:Show()
                        end

                        if self:GetParent().OnSearchTextChanged then
                            self:GetParent():OnSearchTextChanged(self:GetText())
                        end
                    </OnTextChanged>
                    <OnEditFocusGained>
                        self.PlaceholderText:Hide()
                    </OnEditFocusGained>
                    <OnEditFocusLost>
                        if self:GetText() == "" then
                            self.PlaceholderText:Show()
                        end
                    </OnEditFocusLost>
                    <OnLoad>
                        if self:GetParent().InitializeSearchPlaceholder then
                            self:GetParent():InitializeSearchPlaceholder()
                        end
                    </OnLoad>
                </Scripts>
            </EditBox>

            <!--
                Scrolling, single-column event rail on the modern ScrollBox: a WowScrollBoxList plus
                a MinimalScrollBar, wired with a linear view in EventListMixin. Rows come from the
                shared VerticalListItemTemplate via templateKeys.EVENT_DESCRIPTION.
            -->
            <!--
                Period breakdown: the bars (events per slice of the period) and the event-type chips.
                Both narrow the rail together with the search box. Right edge 24 in: the rail's last 12
                run under the book, and the controls keep a Spacing.md margin off that.
                The TypeRow's height follows its content (chips wrap to a second row when a period
                holds many types), so the list anchors to its bottom rather than to a fixed offset.
            -->
            <Frame parentKey="YearBars">
                <Size y="42"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-44"/>
                    <Anchor point="TOPRIGHT" x="-24" y="-44"/>
                </Anchors>
            </Frame>
            <Frame parentKey="TypeRow">
                <Size y="22"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.YearBars" relativePoint="BOTTOMLEFT" x="0" y="-8"/> <!-- Spacing.sm -->
                    <Anchor point="TOPRIGHT" relativeKey="$parent.YearBars" relativePoint="BOTTOMRIGHT" x="0" y="-8"/>
                </Anchors>
            </Frame>

            <Frame parentKey="EventScrollList" inherits="WowScrollBoxList">
                <Anchors>
                    <!-- Left inset clears the scroll bar and leaves it a 4 margin off the rail edge:
                         the bar hangs 8 outside this inset and is itself 8 wide, so 20 is the
                         smallest inset that keeps it off the boundary. The right edge runs to the
                         rail edge, which sits under the book, so the bookmark tips tuck in.
                         The top follows the period breakdown above. -->
                    <!-- x 8: the TypeRow starts 12 in, the list 20 in -->
                    <Anchor point="TOPLEFT" relativeKey="$parent.TypeRow" relativePoint="BOTTOMLEFT" x="8" y="-8"/> <!-- Spacing.sm -->
                    <Anchor point="BOTTOMRIGHT" x="0" y="50"/>
                </Anchors>
            </Frame>
            <!-- Scroll bar on the outer (left) edge so nothing separates the bookmarks from the book -->
            <EventFrame parentKey="EventScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.EventScrollList" relativePoint="TOPLEFT" x="-8" y="-3"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.EventScrollList" relativePoint="BOTTOMLEFT" x="-8" y="2"/>
                </Anchors>
            </EventFrame>
        </Frames>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="CountLabel" inherits="ChroniclesFontFamily_Text_Medium" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="12" y="-24"/> <!-- Spacing.md / -Spacing.xl -->
                        <Anchor point="TOPRIGHT" x="-12" y="-24"/>
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR"/>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

</Ui>