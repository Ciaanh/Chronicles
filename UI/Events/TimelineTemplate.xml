<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

    <Script file="TimelineTemplate.lua" />

    <Frame name="TimelineLabelTemplate" mixin="TimelineLabelMixin" virtual="true">
        <Size x="130" y="25" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" file="Interface\AddOns\Chronicles\Art\label">
                    <Size x="130" y="25"/>
                    <Anchors>
                        <Anchor point="TOP" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="ChroniclesFontFamily_Text_Medium" setAllPoints="true" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR" />
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Button name="TimelinePeriodTemplate" mixin="TimelinePeriodMixin" virtual="true">
        <Size x="130" y="75" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true">
                    <Size x="130" y="75"/>
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="ChroniclesFontFamily_Shadow_Medium" setAllPoints="true" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick method="OnClick" />
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </Button>
    <!--
        The timeline spans the whole tab width and splits it in two columns that line up with the
        rail and the book below:

          Navigator  0..268    above the rail: jump to a year, zoom, jump to an era
          Grid       280..end  above the book: paging, density legend, period grid

        The grid used to be a 1200 frame centred on the tab while the book sits flush right, which
        left the timeline 140 left of the book it drives. The 280 is the rail's 292 minus the 12 it
        runs under the book, so the grid's left edge is the book's left edge.

        The controls stay direct children of the timeline (the mixin reads them as self.ZoomToggle,
        self.Previous, ...) and only anchor to these two layout frames.
    -->
    <!-- A zoom step in the Navigator: the plain wood plate, gold text when it is the current step -->
    <Button name="TimelineZoomButtonTemplate" virtual="true">
        <Size x="58" y="25"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" file="Interface\AddOns\Chronicles\Art\plate" setAllPoints="true"/>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="SelectedGlow" file="Interface\AddOns\Chronicles\Art\plate"
                         alphaMode="ADD" alpha="0.8" setAllPoints="true" hidden="true"/>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" file="Interface\AddOns\Chronicles\Art\plate"
                         alphaMode="ADD" alpha="0.25" setAllPoints="true"/>
            </Layer>
        </Layers>
        <ButtonText parentKey="Text" justifyH="CENTER">
            <Anchors>
                <Anchor point="TOPLEFT" x="4" y="-2"/>
                <Anchor point="BOTTOMRIGHT" x="-4" y="2"/>
            </Anchors>
        </ButtonText>
        <NormalFont style="ChroniclesFontFamily_Text_Medium"/>
    </Button>

    <Frame name="TimelineTemplate" mixin="TimelineMixin" virtual="true">
        <Frames>
            <Frame parentKey="Navigator">
                <Size x="268"/>
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMLEFT" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Background" setAllPoints="true">
                            <Color r="0" g="0" b="0" a="0.35"/>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString parentKey="YearLabel" inherits="ChroniclesFontFamily_Text_Medium" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="12" y="-12" /> <!-- Spacing.md -->
                            </Anchors>
                            <Color color="NORMAL_FONT_COLOR" />
                        </FontString>
                        <FontString parentKey="ZoomLabel" inherits="ChroniclesFontFamily_Text_Medium" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.YearLabel" relativePoint="BOTTOMLEFT" x="0" y="-41" /> <!-- 4 + 25 row + Spacing.md -->
                            </Anchors>
                            <Color color="NORMAL_FONT_COLOR" />
                        </FontString>
                        <FontString parentKey="EraLabel" inherits="ChroniclesFontFamily_Text_Medium" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.ZoomLabel" relativePoint="BOTTOMLEFT" x="0" y="-41" />
                            </Anchors>
                            <Color color="NORMAL_FONT_COLOR" />
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <Frame parentKey="Grid">
                <Anchors>
                    <Anchor point="TOPLEFT" x="280" y="0" />
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
            </Frame>

            <!--
                Layout rail for the grid's toolbar row. It draws nothing and owns no children: the
                paging controls and the density legend anchor LEFT/RIGHT to it, which centres them in
                the row's height without a per-control vertical offset.
            -->
            <Frame parentKey="Toolbar">
                <Size y="38"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Grid" relativePoint="TOPLEFT" x="12" y="-12" />   <!-- Spacing.md -->
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Grid" relativePoint="TOPRIGHT" x="-12" y="-12" />
                </Anchors>
            </Frame>

            <!-- Navigator, first row: jump to a year -->
            <EditBox parentKey="DateSearchInput" inherits="InputBoxTemplate">
                <Size x="180" y="25" />
                <Anchors>
                    <!-- x 6: InputBoxTemplate draws its left cap 5 outside the edit area -->
                    <Anchor point="TOPLEFT" relativeKey="$parent.Navigator.YearLabel" relativePoint="BOTTOMLEFT" x="6" y="-4" /> <!-- Spacing.xs -->
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="PlaceholderText" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT" x="8" y="0" />
                            </Anchors>
                            <Color r="0.5" g="0.5" b="0.5" a="0.8" />
                        </FontString>
                    </Layer>
                </Layers>
            </EditBox>
            <Button parentKey="DateSearchButton" inherits="UIPanelButtonTemplate">
                <Size x="35" y="25" />
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.DateSearchInput" relativePoint="RIGHT" x="8" y="0" /> <!-- Spacing.sm -->
                </Anchors>
            </Button>

            <!--
                Navigator, second row: the zoom, one button per step value. The buttons are built from
                config.stepValues in TimelineMixin:BuildZoomToggle, so a different set of steps needs no
                XML; the selected one is drawn gold (UpdateZoomLevelIndicator).
            -->
            <Frame parentKey="ZoomToggle">
                <Size x="244" y="25" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Navigator.ZoomLabel" relativePoint="BOTTOMLEFT" x="0" y="-4" /> <!-- Spacing.xs -->
                </Anchors>
            </Frame>

            <!--
                Navigator, third row: jump to an era. The menu lists the era events of the enabled
                collections in chronological order and is built in TimelineMixin:InitializeEraJump,
                each time it opens, so toggling a collection in Settings is reflected without a reload.
            -->
            <DropdownButton parentKey="EraDropdown" inherits="WowStyle1DropdownTemplate">
                <Size x="244" y="25" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Navigator.EraLabel" relativePoint="BOTTOMLEFT" x="0" y="-4" /> <!-- Spacing.xs -->
                </Anchors>
            </DropdownButton>

            <!--
                Grid toolbar, right: page the window, with the range it currently covers between the
                two arrows. These were 50x50 buttons skinned with a covenant-sanctum atlas borrowed
                for paging art, which only pointed one way and so needed its texture coordinates
                mirrored in Lua to face right. They now use the same button vocabulary as their
                neighbours in the row.
            -->
            <Button parentKey="Next" inherits="UIPanelButtonTemplate">
                <Size x="24" y="24" />
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.Toolbar" relativePoint="RIGHT" />
                </Anchors>
            </Button>
            <Frame parentKey="RangeIndicator">
                <Size x="170" y="25" /> <!-- wide enough for "lower to upper" with both bounds shown; 120 clipped it -->

                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.Next" relativePoint="LEFT" x="-8" y="0" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Background" file="Interface\AddOns\Chronicles\Art\plate" setAllPoints="true"/>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Text" inherits="ChroniclesFontFamily_Text_Medium" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="4" y="-4" />
                                <Anchor point="BOTTOMRIGHT" x="-4" y="4" />
                            </Anchors>
                            <Color color="HIGHLIGHT_FONT_COLOR" />
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="Previous" inherits="UIPanelButtonTemplate">
                <Size x="24" y="24" />
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.RangeIndicator" relativePoint="LEFT" x="-8" y="0" />
                </Anchors>
            </Button>

            <!--
                Density legend: what the crystal colours mean, so a reader can answer that without
                clicking. Its swatches and labels are built in TimelineMixin:BuildDensityLegend from
                config.timeline.densityTiers, never from literals, so the legend and the crystals cannot
                describe different thresholds.

                It shares the toolbar row with the paging controls, on the left where the year search
                and zoom used to be before they moved to the Navigator.
            -->
            <Frame parentKey="DensityLegend">
                <Size y="13"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Toolbar" relativePoint="LEFT"/>
                    <Anchor point="RIGHT" relativeKey="$parent.Previous" relativePoint="LEFT" x="-12" y="0"/> <!-- Spacing.md -->
                </Anchors>
            </Frame>

            <!--
                The period grid is not declared here. Nine labels and eight periods used to be
                hand-chained in this file, each named — so each published as a frame global, and
                anchored to the next by that global — and the count restated a value that
                config.timeline.pageSize already owns. TimelineMixin:RefreshTimelinePools now builds
                them from that constant, into pools of unnamed frames.
            -->

        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
            <OnMouseWheel method="OnMouseWheel" />
        </Scripts>
    </Frame>


</Ui>