<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
    <Script file="MainFrameUI.lua"/>

    <Frame name="TabUITemplate" inherits="TabSystemOwnerTemplate" mixin="TabUIMixin" virtual="true">

        <Frames>
            <Frame parentKey="Events" frameLevel="100" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
                <Frames>
                    <Frame name="Timeline" parentKey="Timeline" inherits="TimelineTemplate">
                        <Size x="1200" y="175" />
                        <Anchors>
                            <Anchor point="TOP" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="Book" inherits="BookContainerTemplate">
                        <Size x="1200" y="650"/>
                        <Anchors>
                            <Anchor point="BOTTOM" />
                        </Anchors>
                    </Frame>

                    <Frame parentKey="EventList" inherits="EventListTemplate">
                        <Size x="1480" y="650" />
                        <Anchors>
                            <Anchor point="BOTTOM" />
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
            <Frame parentKey="Characters" frameLevel="100" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
                <Frames>
                    <Frame parentKey="MyCharacterList" inherits="VerticalCharacterListSharedTemplate">
                        <Size x="150" y="650"/>
                        <Anchors>
                            <Anchor point="BOTTOMLEFT" x="0" y="0" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="Book" inherits="BookContainerTemplate">
                        <Size x="1200" y="650"/>
                        <Anchors>
                            <Anchor point="BOTTOM" />
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>

            <Frame parentKey="Factions" frameLevel="100" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
                <Frames>
                    <Frame parentKey="MyFactionList" inherits="VerticalFactionListSharedTemplate">
                        <Size x="150" y="650"/>
                        <Anchors>
                            <Anchor point="BOTTOMLEFT" x="0" y="0" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="Book" inherits="BookContainerTemplate">
                        <Size x="1200" y="650"/>
                        <Anchors>
                            <Anchor point="BOTTOM" />
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>

            <Frame parentKey="Settings" frameLevel="100" inherits="SettingsTemplate" hidden="true">
                <Size x="1200" y="650"/>
                <Anchors>
                    <Anchor point="BOTTOM" />
                </Anchors>
            </Frame>

            <!--
                Declared here so parentKey resolution keeps working for TabSystemOwnerMixin,
                but re-parented and re-anchored into the panel's DragStrip by TabUIMixin:OnLoad.
                Anchors are set there, not here.
            -->
            <Frame parentKey="TabSystem" inherits="TabSystemTemplate">
                <KeyValues>
                    <KeyValue key="minTabWidth" value="100" type="number"/>
                    <KeyValue key="maxTabWidth" value="150" type="number"/>
                    <KeyValue key="tabSelectSound" value="SOUNDKIT.UI_CLASS_TALENT_TAB" type="global"/>
                </KeyValues>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="MainFrameUI" mixin="MainFrameUIMixin" parent="UIParent" toplevel="true" frameStrata="DIALOG" enableMouse="true" movable="true" hidden="true">
        <Size x="1525" y="875"/>
        <Anchors>
            <Anchor point="CENTER" y="50" />
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-5">
                <Texture parentKey="Bg">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="7" y="-7"/>
                        <Anchor point="BOTTOMRIGHT" x="-7" y="7"/>
                    </Anchors>
                    <Color r="0.1" g="0.1" b="0.1" a="0.5"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Border" inherits="DialogBorderNoCenterTemplate" frameLevel="20">
                <Anchors>
                    <Anchor point="TOPLEFT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                </Anchors>
            </Frame>

            <!--
                Drag surface. DialogBorderNoCenterTemplate has no title bar to grab, so the
                panel gets an explicit strip. Declared before TabUI on purpose: TabUIMixin:OnLoad
                re-parents its TabSystem in here, and XML children are created in document order.
                Inset 7 to sit inside the border art, matching the Bg texture above.
            -->
            <Frame parentKey="DragStrip" frameLevel="30" enableMouse="true">
                <Size y="40"/> <!-- Spacing.xxl -->
                <Anchors>
                    <Anchor point="TOPLEFT" x="7" y="-7"/>
                    <Anchor point="TOPRIGHT" x="-7" y="-7"/>
                </Anchors>
                <Scripts>
                    <OnDragStart>
                        self:GetParent():StartDragging()
                    </OnDragStart>
                    <OnDragStop>
                        self:GetParent():StopDragging()
                    </OnDragStop>
                </Scripts>
            </Frame>

            <Frame parentKey="TabUI" inherits="TabUITemplate" frameLevel="100">
                <Size x="1480" y="825"/>
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.DragStrip" relativePoint="BOTTOM" />
                </Anchors>
            </Frame>

            <!-- frameLevel above DragStrip (30) so the strip cannot swallow its clicks -->
            <Button parentKey="CloseButton" inherits="UIPanelCloseButton" frameLevel="40">
                <Anchors>
                    <Anchor point="CENTER" relativePoint="TOPRIGHT" x="-8" y="-8"/> <!-- -Spacing.sm -->
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
        </Scripts>
    </Frame>

</Ui>