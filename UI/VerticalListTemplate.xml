<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

    <Script file="VerticalListTemplate.lua" />

    <!--
        Shared Vertical List Item Template

        The one row template in the addon: Events, Characters and Factions all render this. The
        Events tab used to carry its own near-identical EventListItemTemplate at a different height
        with no hover and no selection; templateKeys.EVENT_DESCRIPTION now points here too.

        88 high, not 120: the art inside is 64, so 88 centres it with 12 of breathing room above and
        below and fits 7 bookmarks in the rail's 640 instead of 5. The height is declared twice, here
        and as SetElementExtent(88) in the two list mixins, because a linear scroll view sizes rows
        from the extent and never reads the template's Size.
    -->
    <Button name="VerticalListItemTemplate" mixin="VerticalListItemMixin" virtual="true">
        <Size x="150" y="88"/>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- Bookmark side texture: fixed 45x64 art, pinned to the left edge -->
                <Texture parentKey="Side" file="Interface\AddOns\Chronicles\Art\Bookmark-side">
                    <Size x="45" y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>

                <!--
                    Bookmark content texture: spans from the side art to the row's right edge rather
                    than carrying a fixed 105 width. A linear scroll view stretches each row to the
                    scroll box width, so a fixed-width strip anchored RIGHT would leave a gap in the
                    middle of the row at any rail width other than the original 150.
                -->
                <Texture parentKey="Content" file="Interface\AddOns\Chronicles\Art\Bookmark-content">
                    <Size y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Side" relativePoint="RIGHT" x="0" y="0"/>
                        <Anchor point="RIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>

            <!--
                Selected state. The plumbing (OnClick to setState to subscribe to
                SyncWithCurrentSelection to UpdateVisualSelection to SetSelected) has always been
                there; SetSelected just had nothing to draw. An additive re-draw of the plate itself
                lights the row without introducing a second art family, and it sits one sublevel
                above Content so it reads as the same bookmark, brighter.
            -->
            <Layer level="BACKGROUND" textureSubLevel="1">
                <!--
                    0.45, not 0.35: an additive pass of the plate over itself adds a fraction of the
                    plate's own brightness, and the plate's text band was darkened 20% for contrast with
                    the white label. The same alpha over the darker art added visibly less, so the alpha
                    carries the same 1.25 the darkening took away.
                -->
                <Texture parentKey="SelectedGlow" file="Interface\AddOns\Chronicles\Art\Bookmark-content"
                         alphaMode="ADD" alpha="0.45" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Content"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Content"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="ARTWORK">
                <!-- Item name text, centred in the 64 of art: 12 top, 12 bottom -->
                <FontString parentKey="ItemName" inherits="ChroniclesFontFamily_Text_Shadow_Small" justifyH="CENTER" wordWrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Content" x="10" y="-12" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Content" x="-10" y="12" />
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR" />
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick method="OnClick"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!-- Shared Vertical List Template -->
    <Frame name="VerticalListTemplate" mixin="VerticalListMixin" virtual="true">
        <KeyValues>
            <KeyValue key="layoutType" value="TooltipDefaultDarkLayout" type="string" />
        </KeyValues>
        <Frames>
            <!-- Search box for filtering items -->
            <EditBox parentKey="SearchBox" inherits="InputBoxTemplate" autoFocus="false">
                <Size y="20"/>
                <Anchors>
                    <!-- Spans the rail rather than a fixed 120, which no longer fits the 268 width -->
                    <Anchor point="TOPLEFT" x="12" y="0"/>
                    <Anchor point="TOPRIGHT" x="-12" y="0"/>
                </Anchors>
                <FontString inherits="ChroniclesFontFamily_Text_Medium"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="PlaceholderText" inherits="ChroniclesFontFamily_Text_Medium" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT" x="5" y="0"/>
                            </Anchors>
                            <Color r="0.5" g="0.5" b="0.5" a="0.8"/>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnTextChanged>
                        if self:GetText() ~= "" then
                            self.PlaceholderText:Hide()
                        else
                            self.PlaceholderText:Show()
                        end
                        
                        -- Notify parent of text change
                        if self:GetParent().OnSearchTextChanged then
                            self:GetParent():OnSearchTextChanged(self:GetText())
                        end
                    </OnTextChanged>
                    <OnEditFocusGained>
                        self.PlaceholderText:Hide()
                    </OnEditFocusGained>
                    <OnEditFocusLost>
                        if self:GetText() == "" then
                            self.PlaceholderText:Show()
                        end
                    </OnEditFocusLost>
                    <OnLoad>
                        if self:GetParent().InitializeSearchPlaceholder then
                            self:GetParent():InitializeSearchPlaceholder()
                        end
                    </OnLoad>
                </Scripts>
            </EditBox>

            <!--
                Scrolling item list on the modern ScrollBox: a WowScrollBoxList plus a
                MinimalScrollBar, wired with a linear view in VerticalListMixin. Rows come from the
                shared VerticalListItemTemplate via templateKeys.GENERIC_LIST_ITEM.
            -->
            <Frame parentKey="ItemList" inherits="WowScrollBoxList">
                <Anchors>
                    <!-- x left inset clears the scroll bar and leaves it a 4 margin off the rail edge:
                         the bar hangs 8 outside this inset and is itself 8 wide, so 20 is the
                         smallest inset that keeps it off the boundary.
                         y clears the search box and count label -->
                    <Anchor point="TOPLEFT" x="20" y="-44"/>
                    <!-- right edge runs to the rail edge (under the book) so rows tuck in; y bottom-inset to the book page -->
                    <Anchor point="BOTTOMRIGHT" x="0" y="50"/>
                </Anchors>
            </Frame>
            <!-- Scroll bar on the outer (left) edge so nothing separates the list from the book -->
            <EventFrame parentKey="ItemListScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.ItemList" relativePoint="TOPLEFT" x="-4" y="-3"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.ItemList" relativePoint="BOTTOMLEFT" x="-4" y="2"/>
                </Anchors>
            </EventFrame>
        </Frames>
        <Layers>
            <Layer level="OVERLAY">
                <!-- Item count label -->
                <FontString parentKey="CountLabel" inherits="ChroniclesFontFamily_Text_Medium" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="12" y="-24"/> <!-- Spacing.md / -Spacing.xl -->
                        <Anchor point="TOPRIGHT" x="-12" y="-24"/>
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR"/>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
        </Scripts>
    </Frame>    <!-- Specialized Character Vertical List Template -->

    <Frame name="VerticalCharacterListSharedTemplate" inherits="VerticalListTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                VerticalListMixin.OnLoad(self)
                self:ConfigureForCharacters()
                self:InitializeSearchPlaceholder()
                self:RefreshItemList()
            </OnLoad>
        </Scripts>
    </Frame>    <!-- Specialized Faction Vertical List Template -->
    <Frame name="VerticalFactionListSharedTemplate" inherits="VerticalListTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                VerticalListMixin.OnLoad(self)
                self:ConfigureForFactions()
                self:InitializeSearchPlaceholder()
                self:RefreshItemList()
            </OnLoad>
        </Scripts>
    </Frame>

</Ui>
