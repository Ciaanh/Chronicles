<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns="http://www.blizzard.com/wow/ui/">

    <Script file="Settings.lua"></Script>

    <CheckButton name="ChroniclesSettingsCheckboxTemplate" inherits="InterfaceOptionsCheckButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="0">
                <Texture parentKey="BackgroundHighlight" setAllPoints="true" alpha="0" hidden="true">
                    <Color r="0.3" g="0.3" b="0.5"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter>
                self.BackgroundHighlight:SetAlpha(0.2)
                self.BackgroundHighlight:Show()
            </OnEnter>
            <OnLeave>
                self.BackgroundHighlight:Hide()
            </OnLeave>
        </Scripts>
    </CheckButton>

    <!--
        A settings category is a page marker, drawn with the same bookmark art as every row in the
        Events, Characters and Factions rails: Bookmark-side pinned left at its native 45x64, then
        Bookmark-content stretched to the row's right edge. It replaces four auction-house nav-button
        atlases, which were the last thing in the addon still borrowing the auction house's furniture.

        Same 88 height and same SelectedGlow idiom as the content rails, so the whole window has one
        vocabulary for "this is the thing you are looking at" rather than one per panel.
    -->
    <Button name="CategoryButtonTemplate" parentArray="Buttons" inherits="TruncatedTooltipScriptTemplate" virtual="true" mixin="CategoryButtonMixin">
        <Size x="292" y="88"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Side" file="Interface\AddOns\Chronicles\Art\Bookmark-side">
                    <Size x="45" y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="Content" file="Interface\AddOns\Chronicles\Art\Bookmark-content">
                    <Size y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Side" relativePoint="RIGHT" x="0" y="0"/>
                        <Anchor point="RIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>

            <!-- Selected state, shown from CategoryButtonMixin:SetSelected. See VerticalListTemplate.xml
                 for why the alpha is 0.45. -->
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture parentKey="SelectedGlow" file="Interface\AddOns\Chronicles\Art\Bookmark-content"
                         alphaMode="ADD" alpha="0.45" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Content"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Content"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BORDER">
                <Texture parentKey="HighlightTexture" file="Interface\AddOns\Chronicles\Art\Bookmark-content"
                        alphaMode="ADD" alpha="0.2" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Content"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Content"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <!--
            Still parentKey Text, and still a ButtonText: TruncatedTooltipScriptTemplate's contract is a
            child FontString named Text, and the mixin writes through self.Text.
        -->
        <ButtonText parentKey="Text" justifyH="CENTER">
            <Anchors>
                <Anchor point="TOPLEFT" relativeKey="$parent.Content" x="10" y="-12"/>
                <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Content" x="-10" y="12"/>
            </Anchors>
            <Shadow>
                <Offset>
                    <AbsDimension x="1" y="-1"/>
                </Offset>
                <Color r="0" g="0" b="0"/>
            </Shadow>
        </ButtonText>
        <NormalFont style="ChroniclesFontFamily_Text_Shadow_Small"/>
        <HighlightFont style="ChroniclesFontFamily_Text_Shadow_Small"/>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnClick method="OnClick" />
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </Button>

    <!--
        One page shape, inherited by every settings page. Title, a spellbook rule under it, a
        description, and a scrolling body. Each page used to restate all four, which is why a reskin of
        the panel meant the same edit three times over, and why the three drifted.
    -->
    <Frame name="SettingsPageTemplate" virtual="true" hidden="true">
        <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Title" inherits="ChroniclesFontFamily_Text_Huge" justifyH="LEFT">
                    <Size y="25"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                    </Anchors>
                    <Color color="SPELLBOOK_FONT_COLOR"/>
                </FontString>
                <Texture parentKey="TitleSeparator" atlas="spellbook-divider" useAtlasSize="false">
                    <Size y="8"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeKey="$parent.Title" x="0" y="-5"/>
                        <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" relativeKey="$parent.Title" x="0" y="-5"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Description" inherits="ChroniclesFontFamily_Text_Body" justifyH="LEFT">
                    <Size y="40"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeKey="$parent.TitleSeparator" x="0" y="-10"/>
                        <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" relativeKey="$parent.TitleSeparator" x="0" y="-10"/>
                    </Anchors>
                    <Color color="SPELLBOOK_FONT_COLOR"/>
                </FontString>
            </Layer>
            <Layer level="ARTWORK">
                <!--
                    Rule between the two checkbox columns, the same spellbook-divider the title uses,
                    turned on its side by being drawn narrow and tall. Positioned by
                    SettingsMixin:LayoutCheckboxColumns, which owns the column pitch.
                -->
                <Texture parentKey="ColumnDivider" atlas="spellbook-divider" useAtlasSize="false" hidden="true">
                    <Size x="8" y="200"/>
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.Description" x="0" y="-10"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <ScrollFrame parentKey="ScrollFrame" mixin="ScrollFrameMixin" enableMouse="true">
                <KeyValues>
                    <KeyValue key="scrollOnMouse" value="true" type="boolean"/>
                    <KeyValue key="scrollBarHideIfUnscrollable" value="true" type="boolean"/>
                    <KeyValue key="scrollBarX" value="10" type="number"/>
                    <KeyValue key="scrollBarTopY" value="-10" type="number"/>
                    <KeyValue key="scrollBarBottomY" value="10" type="number"/>
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeKey="$parent.Description" x="0" y="-10"/>
                    <Anchor point="BOTTOMRIGHT" x="-20" y="0"/>
                </Anchors>
                <ScrollChild>
                    <Frame parentKey="Content">
                        <Size x="1" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                    </Frame>
                </ScrollChild>
                <Scripts>
                    <OnLoad method="OnLoad"/>
                </Scripts>
            </ScrollFrame>
        </Frames>
    </Frame>

    <Frame name="SettingsTemplate" virtual="true" mixin="SettingsMixin">
        <Size x="1200" y="640"/>

        <Layers>
            <!--
                The same spellbook page pair the book uses, so Settings is a page of the same book
                rather than a panel borrowed from the auction house. What this replaces: a tiling
                UI-Background-Rock, a dark overlay wash, and a NineSlicePanelTemplate that drew a second
                border *inside* the window's own dialog border.
            -->
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture parentKey="BgLeft" atlas="spellbook-background-evergreen-left" useAtlasSize="false">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="BgRight" atlas="spellbook-background-evergreen-right" useAtlasSize="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOP"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <!--
                    Feedback sits under the content column it describes. It used to be anchored 200 in
                    from the panel's left edge, a number that meant "just past the category rail" and
                    pointed at nothing once the rail's width changed. The real anchor is applied in
                    SettingsMixin:OnLoad against the TabUI column: a Layer cannot reference a sibling
                    frame declared after it, and layers are built before frames.
                -->
                <FontString parentKey="Status" inherits="ChroniclesFontFamily_Text_Body" justifyH="LEFT">
                    <Size y="24"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="50" y="20"/>
                    </Anchors>
                    <Color color="SPELLBOOK_FONT_COLOR"/>
                </FontString>
            </Layer>
        </Layers>

        <Animations>
            <!--
                Status fades out three seconds after a message appears, so feedback about something the
                reader has already moved on from does not sit there for the rest of the session.
                SettingsMixin:ShowStatus restarts it on every message. Declared on the frame rather than
                on the FontString because an AnimationGroup belongs to a frame; childKey aims it at the
                string.
            -->
            <AnimationGroup parentKey="StatusFadeOut">
                <Alpha childKey="Status" duration="1.5" startDelay="3" order="1" fromAlpha="1" toAlpha="0"/>
            </AnimationGroup>
        </Animations>

        <Frames>
            <!--
                Category rail, 292 wide like the content tabs' rails, its rows tucking 12 under the page
                beside it. It was 200 x 445 for three buttons of 24; it is now sized to the two
                categories it actually has.
            -->
            <Frame parentKey="CategoriesList">
                <Anchors>
                    <Anchor point="TOPLEFT" x="50" y="-50"/> <!-- page padding -->
                    <Anchor point="BOTTOMLEFT" x="50" y="50"/>
                </Anchors>
                <Size x="292"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Header" inherits="ChroniclesFontFamily_Text_Huge" justifyH="CENTER">
                            <Size y="25"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="TOPRIGHT"/>
                            </Anchors>
                            <Color color="SPELLBOOK_FONT_COLOR"/>
                        </FontString>
                        <Texture parentKey="HeaderSeparator" atlas="spellbook-divider" useAtlasSize="false">
                            <Size y="8"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeKey="$parent.Header" x="0" y="-5"/>
                                <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" relativeKey="$parent.Header" x="0" y="-5"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>

            <!--
                Pages. Anchored off the rail's right edge with the same 12 overlap the content tabs use,
                so a selected category's bookmark tucks under the page it opens. The
                auctionhouse-background-index texture that used to back this frame is gone: the
                spellbook page art behind it makes a second background redundant.
            -->
            <Frame parentKey="TabUI">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CategoriesList" relativePoint="TOPRIGHT" x="-12" y="0"/>
                    <Anchor point="BOTTOMRIGHT" x="-50" y="50"/>
                </Anchors>

                <Frames>
                    <Frame parentKey="EventTypes" inherits="SettingsPageTemplate" frameLevel="100"/>
                    <Frame parentKey="Collections" inherits="SettingsPageTemplate" frameLevel="100"/>
                </Frames>
            </Frame>

        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

</Ui>
