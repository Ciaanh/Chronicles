<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

    <Script file="HTMLContentTemplate.lua"/>

    <!-- =============================================================================================
    NEW HTML CONTENT TEMPLATE
    ============================================================================================= 
    
    Single HTML container for the new Chronicles book system.
    Displays complete HTML documents generated by NewHTMLBuilder.
    
    This replaces the multi-template system with a unified approach where all content types
    (events, characters, factions) are displayed as complete HTML documents in a single container.
    
    FEATURES:
    - Single template for all content types
    - Complete HTML document display
    - Automatic height adjustment
    - Scroll support for long content
    - Error handling and fallback display
    - Debug and development support
    
    USAGE:
    The template expects elementData with:
    - htmlContent: Complete HTML document string
    - title: Content title for reference
    - entity: Original entity data (optional, for debugging)
    
    ============================================================================================= -->

    <Frame name="HTMLContentTemplate" mixin="HTMLContentMixin" virtual="true">
        <!--
            Must fit one page view: the book is 640 tall (MainFrameUI.xml) and PagedDetails is inset 50
            top and bottom, so a view is 540. The pager moves an element that does not fit to the next
            view, so at 550 (sized for the old 650 book) every front matter skipped the left page and
            every event opened on a blank left page with its text pushed to page 2.
        -->
        <Size x="500" y="540"/>
        <Anchors>
            <Anchor point="TOPLEFT"/>
        </Anchors>

        <Frames>
            <!-- Main scroll frame for HTML content -->
            <ScrollFrame parentKey="ScrollFrame" mixin="ScrollFrameMixin" enableMouse="false">
                <KeyValues>
                    <KeyValue key="scrollOnMouse" value="true" type="boolean"/>
                    <KeyValue key="scrollBarHideIfUnscrollable" value="true" type="boolean"/>
                    <KeyValue key="scrollBarX" value="14" type="number"/>
                    <KeyValue key="scrollBarTopY" value="-25" type="number"/>
                    <KeyValue key="scrollBarBottomY" value="25" type="number"/>
                </KeyValues>
                <Size x="500" y="510"/> <!-- the element's 540 minus the 20 top inset, 10 spare at the bottom -->
                <Anchors>
                    <Anchor point="TOPLEFT" y="-20"/>
                </Anchors>

                <ScrollChild>
                    <SimpleHTML parentKey="HTML" resizeToFitContents="true" justifyH="LEFT" inherits="InlineHyperlinkFrameTemplate">
                        <Size x="500"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                        <!-- Body prose at 15, one step above the 14 the panel chrome uses -->
                        <FontString inherits="ChroniclesFontFamily_Text_Body">
                            <Color color="SPELLBOOK_FONT_COLOR"/>
                        </FontString>
                        <FontStringHeader1 inherits="ChroniclesFontFamily_Text_Huge" spacing="4">
                            <Color color="SPELLBOOK_FONT_COLOR"/>
                        </FontStringHeader1>
                        <!--
                            h2 is a label, not a heading: the CHAPTER n eyebrow on the body page and the
                            FACTIONS / CHARACTERS / Contents sub-heads on the front matter. Small on
                            purpose, and in the book's own font with the parchment colour. Declared at
                            all because an undeclared header font falls back to a gold system font,
                            which is what the commented-out GameFontHighlight stub would have done.
                        -->
                        <FontStringHeader2 inherits="ChroniclesFontFamily_Text_Medium" spacing="4">
                            <Color color="SPELLBOOK_FONT_COLOR"/>
                        </FontStringHeader2>
                        <!-- h3 is a chapter's own header, present only when a record actually sets one -->
                        <FontStringHeader3 inherits="ChroniclesFontFamily_Text_Medium" spacing="4">
                            <Color color="SPELLBOOK_FONT_COLOR"/>
                        </FontStringHeader3>
                    </SimpleHTML>
                </ScrollChild>

                <Scripts>
                    <OnLoad method="OnLoad"/>
                </Scripts>
            </ScrollFrame>
        </Frames>
    </Frame>

</Ui>
